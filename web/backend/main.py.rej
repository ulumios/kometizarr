+def _backup_clean_plex_poster(manager, item):
+    """Replace a possibly Kometa-contaminated original after selecting agent artwork."""
+    if item.type == 'episode':
+        if not getattr(item, 'thumb', None):
+            return False
+        original = manager.backup_manager.backup_dir / manager.library_name / 'episodes' / str(item.ratingKey) / 'original.jpg'
+        original.unlink(missing_ok=True)
+        return True
+    poster_url = getattr(item, 'posterUrl', None)
+    if not poster_url:
+        return False
+    return bool(manager.backup_manager.backup_poster(
+        library_name=manager.library_name, item_title=item.title, poster_url=poster_url,
+        item_metadata={'rating_key': item.ratingKey, 'year': getattr(item, 'year', None)},
+        plex_token=manager.plex_token, force=True, year=getattr(item, 'year', None)))
+
+
+def _use_current_plex_poster(manager, item):
+    """Keep the previous original and replace it with verified current Plex artwork."""
+    import shutil
+    from PIL import Image
+    from pathlib import Path
+    if item.type == 'episode':
+        thumb = getattr(item, 'thumb', None)
+        if not thumb:
+            return False
+        original = manager.backup_manager.backup_dir / manager.library_name / 'episodes' / str(item.ratingKey) / 'original.jpg'
+        url = manager.server.url(thumb)
+    else:
+        url = getattr(item, 'posterUrl', None)
+        if not url:
+            return False
+        original = manager.backup_manager._get_backup_path(
+            manager.library_name, item.title, year=getattr(item, 'year', None)) / 'poster_original.jpg'
+    original.parent.mkdir(parents=True, exist_ok=True)
+    pending = Path(str(original) + '.current.pending')
+    try:
+        response = manager.server._session.get(url, headers={'X-Plex-Token': manager.plex_token}, timeout=30)
+        response.raise_for_status()
+        pending.write_bytes(response.content)
+        with Image.open(pending) as image:
+            image.verify()
+        if original.exists():
+            previous = original.with_name(f'{original.stem}.previous-{time.time_ns()}{original.suffix}')
+            shutil.copy2(original, previous)
+        os.replace(pending, original)
+        return True
+    except Exception:
+        logger.exception('Could not save current Plex artwork for %s', item.ratingKey)
+        return False
+    finally:
+        pending.unlink(missing_ok=True)
+
+
